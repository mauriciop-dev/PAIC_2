# Insforge (Supabase-compatible)
INSFORGE_URL=https://your-project.us-east.insforge.app
INSFORGE_ANON_KEY=your-anon-key
INSFORGE_SERVICE_ROLE_KEY=your-service-role-key

# AI Provider Keys (for Vercel backend env vars, NOT for frontend)
GEMINI_API_KEY=your-gemini-key
GROQ_API_KEY=your-groq-key
DEEPSEEK_API_KEY=your-deepseek-key

# Frontend Vite vars (used at build time)
VITE_INSFORGE_URL=https://your-project.us-east.insforge.app
VITE_INSFORGE_ANON_KEY=your-anon-key

# Mercado Pago
VITE_MERCADO_PAGO_PUBLIC_KEY=your-public-key
VITE_MERCADO_PAGO_ACCESS_TOKEN=your-access-token
